# Builds the web (wasm32) GDExtension, which implements the API on livekit-client in the browser
# instead of the native LiveKit SDK. Run via `./build.sh web`, or directly with:
#   scons -f SConstruct.web platform=web target=template_release threads=no
import os

# godot-cpp's own SConstruct sets up the Emscripten side-module toolchain that Godot's web
# templates require, and builds godot-cpp itself.
env = SConscript("godot-cpp/SConstruct")
if env["platform"] != "web":
    print("SConstruct.web only builds platform=web.")
    Exit(1)


def embed_js(target, source, env):
    """Embeds livekit-client and the bridge as one NUL-terminated byte array."""
    data = b"".join(open(str(s), "rb").read() + b"\n" for s in source) + b"\0"
    with open(str(target[0]), "w") as f:
        f.write("#pragma once\n// Generated by SConstruct.web. Do not edit.\n")
        f.write("static const unsigned char GODOT_LIVEKIT_WEB_JS[] = {")
        f.write(",".join(str(b) for b in data))
        f.write("};\n")


livekit_js = "livekit-js/livekit-client.umd.js"
if not os.path.exists(livekit_js):
    print("Missing %s. Run `./build.sh web` to download it." % livekit_js)
    Exit(1)

embedded_js = env.Command("src/web/gen/livekit_web_js.gen.h", [livekit_js, "src/web/bridge.js"], embed_js)
env.Append(CPPPATH=["src/web"])

lib_name = "libgodot-livekit.web.wasm32{}.wasm".format("" if env["threads"] else ".nothreads")
library = env.SharedLibrary(target=lib_name, source=Glob("src/web/*.cpp"))
env.Depends(library, embedded_js)
Default(env.Install("addons/godot-livekit/bin", library))
